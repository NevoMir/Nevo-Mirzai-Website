# Local secrets for `wrangler dev` (copy to .dev.vars, which is gitignored). In production set them with
# `wrangler secret put <NAME>`. A model is offered in the picker only when one of its API keys is set.

# fal.ai queue API: Rodin Gen-2.5, Hunyuan 3D 3.1, and the fallback route for Tripo and Meshy.
FAL_KEY=
# Tripo direct API: "Tripo H3.1 Parts" (multi-part assembly) and Tripo H3.1.
TRIPO_API_KEY=
# Meshy direct API: Meshy 7.1.
MESHY_API_KEY=
# Tencent Cloud API key pair: Hunyuan 3D through Tencent's own API (HY 3D Global).
TENCENTCLOUD_SECRET_ID=
TENCENTCLOUD_SECRET_KEY=
# OpenRouter: "Muse Spark 1.3", an AI assembly designer (a text model returns the parts of the object as JSON, the app builds the GLB).
# It runs in a Cloudflare Queue consumer (wrangler.jsonc: LLM_QUEUE), which `wrangler dev` provides locally.
OPENROUTER_API_KEY=
# Optional: the OpenRouter model id (default meta/muse-spark-1.3-contributor).
OPENROUTER_MODEL=
# Optional: when set, generating needs this code (sent as the x-access-code header).
ACCESS_CODE=
# Without an ACCESS_CODE, paid models stay switched off unless this is 1 (wrangler.jsonc sets it: open access).
ALLOW_OPEN_GENERATION=
# Optional: a positive number caps paid generations per UTC day; unset means no cap.
DAILY_GENERATION_LIMIT=
# Optional: a positive number caps the stabilized versions saved per UTC day (default 300; each is one R2 write of at most 1 MiB,
# nothing is generated or paid for).
DAILY_DERIVED_LIMIT=
# Set to 1 to enable the offline "Demo" provider, which replays a bundled desk-lamp assembly without any API call.
MOCK_PROVIDER=
