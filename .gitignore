*.ogg

# Original images — converted to WebP, keep originals locally only
src/assets/projects/**/*.png
src/assets/projects/**/*.jpg
src/assets/projects/**/*.jpeg

# Auto-generated data (rebuilt by prebuild scripts)
src/data/repos.json

node_modules
dist
dist-ssr
*.local

