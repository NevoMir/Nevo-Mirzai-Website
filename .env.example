# Cloudflare R2 public bucket URL for video hosting.
# Get this from: Cloudflare Dashboard > R2 > your bucket > Settings > Public access
# Example: https://pub-abc123.r2.dev
VITE_R2_PUBLIC_URL=https://pub-YOUR_BUCKET_ID.r2.dev

# GitHub credentials (for fetching repos during build)
GITHUB_USERNAME=
GITHUB_TOKEN=
