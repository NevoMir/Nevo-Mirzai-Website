{
  "name": "nevo-mirzai-website",
  "compatibility_date": "2026-03-28",
  // The Worker only runs for the text-to-3D assignment (/assignment_alex and its API).
  // Every other path is served straight from ./dist as before, without invoking it.
  "main": "./worker/index.ts",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/assignment_alex/*", "/assignment_alex", "/assignment_alex/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "assignment-alex",
      "database_id": "eef6ff34-a14d-4da9-b33f-ff0f9758d76d",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "FILES",
      "bucket_name": "assignment-alex-models"
    }
  ],
  // The Muse assembly designer (an LLM via OpenRouter, ~20-60 s per design) runs in this queue's consumer (worker/llm.ts): a
  // Free-plan request may only use 10 ms of CPU and a waitUntil 30 s. One message designs one object. Create the queue once:
  // `npx wrangler queues create assignment-alex-llm`. The OPENROUTER_API_KEY secret turns the model on. The consumer stages small
  // files under llm/ in the bucket above; expire them once so a closed tab or a lost message leaves nothing behind:
  // `npx wrangler r2 bucket lifecycle add assignment-alex-models llm-staging llm/ --expire-days 1`.
  "queues": {
    "producers": [{ "binding": "LLM_QUEUE", "queue": "assignment-alex-llm" }],
    "consumers": [
      {
        "queue": "assignment-alex-llm",
        "max_batch_size": 1,
        "max_batch_timeout": 1,
        "max_retries": 2,
        "max_concurrency": 5
      }
    ]
  },
  "vars": {
    // Open to everyone: no access code and no daily cap (set DAILY_GENERATION_LIMIT to a positive number, or the
    // ACCESS_CODE secret, to bring either back).
    "ALLOW_OPEN_GENERATION": "1",
    // Optional: DAILY_DERIVED_LIMIT caps the stabilized versions saved per UTC day (default 300; each is one R2 write
    // of at most 1 MiB, nothing is generated or paid for).
    // The offline "Demo" model (MOCK_PROVIDER=1) is for local development and tests only (.dev.vars); production
    // offers Hunyuan 3D and Muse Spark (worker/providers/index.ts OFFERED_PROVIDERS).
    // Optional: the OpenRouter model of the Muse designer (default "meta/muse-spark-1.3-contributor").
    // "OPENROUTER_MODEL": "meta/muse-spark-1.3-contributor"
    // Optional, for the AI editor (edits by words and the optimizer's goal writer, worker/README.md):
    //   DAILY_LLM_LIMIT          AI calls per UTC day, edit jobs and the two direct calls together (default 400, about $0.2 a day)
    //   DAILY_EDIT_UPLOAD_LIMIT  edited 3D models uploaded per UTC day (default 30; each is 15 to 28 MB of R2)
    //   OPENROUTER_EDIT_MODEL    another OpenRouter model id for these calls (default OPENROUTER_MODEL)
  },
  "observability": {
    "enabled": true
  }
}
